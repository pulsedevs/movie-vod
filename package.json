{
  "name": "my-movie-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "node scripts/build-with-timestamp.js",
    "build:win": "scripts\\build-with-timestamp.bat",
    "build:simple": "next build",
    "start": "next start",
    "lint": "next lint",
    "build:optimized": "node scripts/optimize-build.js",
    "analyze": "cross-env ANALYZE=true next build",
    "analyze:server": "cross-env BUNDLE_ANALYZE=server next build",
    "analyze:browser": "cross-env BUNDLE_ANALYZE=browser next build",
    "fix:status-column": "node apply-status-column-fix.js",
    "verify:status-fix": "node verify-status-fix-simple.js",
    "purge-cache": "node scripts/purge-cloudflare-cache.js",
    "deploy": "node scripts/deploy-and-purge.js",
    "deploy:safe": "npm run build && npm run purge-cache",
    "security:audit": "npm audit",
    "security:fix": "npm audit fix",
    "security:check": "npm outdated && npm audit",
    "security:update": "npm update && npm audit fix",
    "predeploy": "npm run security:audit"
  },
  "dependencies": {
    "@radix-ui/react-tabs": "^1.1.12",
    "@supabase/auth-ui-react": "^0.4.7",
    "@supabase/auth-ui-shared": "^0.1.8",
    "@supabase/supabase-js": "^2.49.10",
    "@tailwindcss/line-clamp": "^0.4.4",
    "@types/puppeteer": "^5.4.7",
    "@types/video.js": "^7.3.58",
    "autoprefixer": "^10.4.21",
    "cheerio": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "critters": "^0.0.23",
    "dotenv": "^16.5.0",
    "firebase": "^11.9.0",
    "framer-motion": "^12.9.4",
    "hls.js": "^1.7.2",
    "ignore-loader": "^0.1.2",
    "ioredis": "^5.6.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.507.0",
    "next": "^15.4.10",
    "nextjs-toploader": "^3.9.17",
    "plyr": "^3.7.8",
    "react": "^19.1.5",
    "react-dom": "^19.1.5",
    "react-icons": "^5.5.0",
    "react-intersection-observer": "^9.16.0",
    "tailwind-merge": "^3.3.0",
    "video.js": "^8.23.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@next/bundle-analyzer": "^15.3.3",
    "@tailwindcss/postcss": "^4.1.5",
    "@types/cheerio": "^0.22.35",
    "@types/hls.js": "^1.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^7.0.3",
    "eslint": "^9",
    "eslint-config-next": "^15.3.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
